PGHOST=127.0.0.1
PGPORT=6432
PGDATABASE=gcssync
PGUSER=gcssync
PGPASSWORD=change-me
PUBSUB_SUBSCRIPTION=projects/<project>/subscriptions/gcs-azureblob-sync
GOOGLE_APPLICATION_CREDENTIALS=/opt/gcs-azure-sync/gcp-sa.json
AZURE_QUEUE_CONN_STR=<storage-account-connection-string>
AZURE_QUEUE_NAME=blob-events
GCS_REMOTE=gcs
AZURE_REMOTE=azure
BATCH_MAX_FILES=5000
BATCH_MAX_BYTES=5368709120
BATCH_MAX_AGE_SEC=120
MAX_RETRY=5
